%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 09f1f81537bd15a4491eecd67f31807c, type: 3}
  m_Name: IntroStoryData
  m_EditorClassIdentifier: 
  pages:
  - backgroundImage: {fileID: 1327667469861204045, guid: 6e33e34c685707e478b9a8b7ee0599e7, type: 3}
    lines:
    - speaker: 1
      text: "6\uAC1C\uC6D4 \uC804, \uC544\uB0B4\uAC00 \uC138\uC0C1\uC744 \uB5A0\uB0AC\uB2E4."
      displayDuration: 0
  - backgroundImage: {fileID: 1327667469861204045, guid: 6e33e34c685707e478b9a8b7ee0599e7, type: 3}
    lines:
    - speaker: 1
      text: "\uC644\uBCBD\uD558\uAC8C \uB3CC\uC544\uAC00\uB358 \uB098\uC758 \uB808\uC2A4\uD1A0\uB791\uB3C4,
        \uB098\uC758 \uC138\uC0C1\uB3C4... \uADF8\uB0A0 \uD568\uAED8 \uBA48\uCDB0\uBC84\uB838\uB2E4."
      displayDuration: 0
  - backgroundImage: {fileID: 1327667469861204045, guid: 6e33e34c685707e478b9a8b7ee0599e7, type: 3}
    lines:
    - speaker: 1
      text: "\uBD88\uC744 \uB2E4\uB8E8\uB294 \uAC83\uB3C4, \uC0AC\uB78C\uC744 \uB9C8\uC8FC\uD558\uB294
        \uAC83\uB3C4 \uB450\uB824\uC6CC\uC84C\uB2E4.\n\uAE4A\uC740 \uC808\uB9DD \uC18D\uC5D0\uC11C
        \uBAA8\uB4E0 \uAC83\uC744 \uB193\uC544\uBC84\uB838\uB2E4."
      displayDuration: 0
  - backgroundImage: {fileID: 1327667469861204045, guid: 6e33e34c685707e478b9a8b7ee0599e7, type: 3}
    lines:
    - speaker: 1
      text: "\uD558\uC9C0\uB9CC... \uC0B4\uC544\uAC00\uC57C \uD588\uB2E4."
      displayDuration: 0
  - backgroundImage: {fileID: 1327667469861204045, guid: 6e33e34c685707e478b9a8b7ee0599e7, type: 3}
    lines:
    - speaker: 1
      text: "\uD654\uB824\uD55C \uCF54\uC2A4 \uC694\uB9AC \uB300\uC2E0 \uB0B4\uAC00
        \uC120\uD0DD\uD55C \uAC83\uC740 \uAE38\uAC70\uB9AC\uC758 \uB0A1\uC740 \uD478\uB4DC\uD2B8\uB7ED."
      displayDuration: 0
  - backgroundImage: {fileID: 1327667469861204045, guid: 6e33e34c685707e478b9a8b7ee0599e7, type: 3}
    lines:
    - speaker: 1
      text: "\uADF8\uB9AC\uACE0 \uAC00\uC7A5 \uD22C\uBC15\uD558\uACE0 \uD3C9\uBC94\uD55C
        \uC74C\uC2DD, \uD56B\uB3C4\uADF8\uC600\uB2E4."
      displayDuration: 0
  - backgroundImage: {fileID: 1327667469861204045, guid: 6e33e34c685707e478b9a8b7ee0599e7, type: 3}
    lines:
    - speaker: 1
      text: "\uC7BF\uBE5B\uC73C\uB85C \uBCC0\uD574\uBC84\uB9B0 \uB098\uC758 \uC138\uC0C1."
      displayDuration: 0
  - backgroundImage: {fileID: 1327667469861204045, guid: 6e33e34c685707e478b9a8b7ee0599e7, type: 3}
    lines:
    - speaker: 1
      text: "\uC774 \uC791\uC740 \uCC3D\uBB38 \uB108\uBA38\uB85C \uC0AC\uB78C\uB4E4\uC758
        \uC774\uC57C\uAE30\uB97C \uB4E3\uACE0, \uC74C\uC2DD\uC744 \uB0B4\uC5B4\uC8FC\uB2E4
        \uBCF4\uBA74..."
      displayDuration: 0
  - backgroundImage: {fileID: 1327667469861204045, guid: 6e33e34c685707e478b9a8b7ee0599e7, type: 3}
    lines:
    - speaker: 1
      text: "\uC783\uC5B4\uBC84\uB9B0 \uC0C9\uC744 \uC870\uAE08\uC740 \uB418\uCC3E\uC744
        \uC218 \uC788\uC744\uAE4C?"
      displayDuration: 0
  - backgroundImage: {fileID: 1327667469861204045, guid: 6e33e34c685707e478b9a8b7ee0599e7, type: 3}
    lines:
    - speaker: 1
      text: "\uADF8\uB7EC\uB358 \uC5B4\uB290 \uB0A0, \uB098\uB97C \uB5A0\uB09C \uADF8\uB140\uC5D0\uAC8C\uC11C
        \uD55C \uD1B5\uC758 \uD3B8\uC9C0\uAC00 \uB3C4\uCC29\uD588\uB2E4."
      displayDuration: 0
  - backgroundImage: {fileID: 1327667469861204045, guid: 6e33e34c685707e478b9a8b7ee0599e7, type: 3}
    lines:
    - speaker: 1
      text: "...\uC774\uC81C, \uC2DC\uB3D9\uC744 \uAC78 \uC2DC\uAC04\uC774\uB2E4."
      displayDuration: 0
